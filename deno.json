{
  "tasks": {
    "test": "deno test --allow-read tests/",
    "test:parallel": "deno test --parallel --allow-read tests/",
    "check": "deno check tests/*.ts src/lib/*.ts",
    "e2e": "deno run -A npm:@playwright/test test --workers=3"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "lint": {
    "include": ["src/", "tests/"],
    "rules": {
      "exclude": [
        "no-explicit-any",
        "no-window",
        "no-window-prefix",
        "require-await",
        "no-sloppy-imports",
        "prefer-const"
      ]
    }
  },
  "test": {
    "include": ["tests/"]
  },
  "unstable": ["sloppy-imports"]
}
